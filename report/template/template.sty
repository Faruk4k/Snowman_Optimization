% Language specific keywords

\newcommand{\setLanguage}[1]{
    \ifthenelse{\equal{#1}{english}}{
        \RequirePackage[english]{babel}		% for English keywords like "Abstract"

        % titlepage
        \newcommand{\getUni}{University of Bonn}
        \newcommand{\getDepartment}{Institute of Computer Science 4}
        \newcommand{\getGroup}{Behavioral Security Group}
    
        \newcommand{\langAuthor}{Author}
        \newcommand{\langFirstExaminer}{First Examiner}
        \newcommand{\langSecondExaminer}{Second Examiner}
        \newcommand{\langSupervisor}{Supervisor}
        \newcommand{\langSubmissionDate}{Date of submission}
    
        % chapter names
        \newcommand{\langAbstract}{Abstract}
        \newcommand{\langStatements}{General statements}
        \newcommand{\langPreface}{Contents}
        \renewcaptionname{english}{\contentsname}{Table of Contents}
        \newcommand{\langTableOfContents}{\contentsname}
        \newcommand{\langListOfFigures}{List of Figures}
        \newcommand{\langListOfTables}{List of Tables}
        \newcommand{\langListOfListings}{List of Listings}
        \newcommand{\langAcronyms}{List of Acronyms}
        \newcommand{\langGlossary}{Glossary}
        \newcommand{\langBibliography}{Bibliography}
        \newcommand{\langAppendix}{Appendix}
        \newcommand{\langPlace}{Place}
        \newcommand{\langDate}{Date}
        \newcommand{\langSignature}{Signature}
    }
    {\ifthenelse{\equal{#1}{ngerman}}{
        \RequirePackage[ngerman]{babel}		% for English keywords like "Abstract"
    
        % titlepage
        \newcommand{\getUni}{Rheinische Friedrich-Wilhelms-Universität Bonn}
        \newcommand{\getDepartment}{Institut für Informatik 4}
        \newcommand{\getGroup}{Behavioral Security Gruppe}
    
        \newcommand{\langFirstExaminer}{Erstprüfer}
        \newcommand{\langSecondExaminer}{Zweitprüfer}
        \newcommand{\langSupervisor}{Betreuer}
        \newcommand{\langSubmissionDate}{Abgabedatum}
    
        % chapter names
        \newcommand{\langAbstract}{Zusammenfassung}
        \newcommand{\langStatements}{Allgemeine Hinweise}
        \newcommand{\langPreface}{Inhalt}
        \renewcaptionname{ngerman}{\contentsname}{Inhaltsverzeichnis}
        \renewcaptionname{ngerman}{\listfigurename}{Abbildungsverzeichnis}
        \renewcaptionname{ngerman}{\listtablename}{Tabellenverzeichnis}
        \renewcommand{\lstlistlistingname}{Listingverzeichnis}
        \newcommand{\langTableOfContents}{\contentsname}
        \newcommand{\langListOfFigures}{Abbildungsverzeichnis}
        \newcommand{\langListOfTables}{Tabellenverzeichnis}
        \newcommand{\langListOfListings}{Listingverzeichnis}
        \newcommand{\langAcronyms}{Abkürzungsverzeichnis}
        \newcommand{\langGlossary}{Glossar}
        \newcommand{\langBibliography}{Literatur}
        \newcommand{\langAppendix}{Anhang}
        \newcommand{\langPlace}{Ort}
        \newcommand{\langDate}{Datum}
        \newcommand{\langSignature}{Unterschrift}
    }
    {\PackageWarning{template}{`\CurrentOption' is not a valid language}}}
}

% Getters and setters for information
\newcommand{\setTextTypeImpl}[3]{
    \newcommand{\getTextType}{#1}
    \setLanguage{#2}
    \setTitlepageFile{#3}
}
\newcommand{\setTextType}[1]{%
    \IfStrEqCase{#1}{%
        {Todo}                          {\setTextTypeImpl{\todo{Text type/Texttyp}}{english}{template/titlepage_none.tex}}%
        {Master Thesis}                 {\setTextTypeImpl{#1}{english}{template/titlepage_thesis.tex}}%
        {Lab Report}                    {\setTextTypeImpl{#1}{english}{template/titlepage_report.tex}}%
        {Seminar Report}                {\setTextTypeImpl{#1}{english}{template/titlepage_report.tex}}%
        {Internship Report}             {\setTextTypeImpl{#1}{english}{template/titlepage_report.tex}}%
        {Exposé for a Master Thesis}    {\setTextTypeImpl{#1}{english}{template/titlepage_expose.tex}}%
        {Exposé for a Lab}              {\setTextTypeImpl{#1}{english}{template/titlepage_expose.tex}}%
        {Exposé for a Seminar}          {\setTextTypeImpl{#1}{english}{template/titlepage_expose.tex}}%
        {Exposé for an Internship}      {\setTextTypeImpl{#1}{english}{template/titlepage_expose.tex}}%
        {Bachelorarbeit}                {\setTextTypeImpl{#1}{ngerman}{template/titlepage_thesis.tex}}%
        {Projektbericht}                {\setTextTypeImpl{#1}{ngerman}{template/titlepage_report.tex}}%
        {Seminarbericht}                {\setTextTypeImpl{#1}{ngerman}{template/titlepage_report.tex}}%
        {Praktikumsbericht}             {\setTextTypeImpl{#1}{ngerman}{template/titlepage_report.tex}}%
        {Exposé für eine Bachelorarbeit}{\setTextTypeImpl{#1}{ngerman}{template/titlepage_expose.tex}}%
        {Exposé für eine Projektgruppe} {\setTextTypeImpl{#1}{ngerman}{template/titlepage_expose.tex}}%
        {Exposé für ein Seminar}        {\setTextTypeImpl{#1}{ngerman}{template/titlepage_expose.tex}}%
        {Exposé für ein Praktikum}      {\setTextTypeImpl{#1}{ngerman}{template/titlepage_expose.tex}}%
    }[%
        \PackageError{Template}{Invalid value for text type: #1}%
    ]
}
                    
