% Text style and page layout intro, main, outro and samples
\raggedbottom                   % spacing between paragraphs is always the same

% intro
\newcommand{\beginIntro}{
	\pagenumbering{Roman}
	\setcounter{page}{1}

	\setstretch{1}
}
% main
\newcommand{\beginContent}{
    % for two-sided prints a cleardoublepage is necessary because otherwise
    % the resetting of the page number might cause two directly successive
    % odd pages which breaks the layout as odd and even lose their meaning
    \cleardoublepage

	\setcounter{chapter}{0}
	\setcounter{section}{0}

	\pagenumbering{arabic}
	\setcounter{page}{1}

	\setstretch{1.0}
}
% outro
\newcommand{\beginClosing}{
    % for two-sided prints a cleardoublepage is necessary because otherwise
    % the resetting of the page number might cause two directly successive
    % odd pages which breaks the layout as odd and even lose their meaning
    \cleardoublepage

	\pagenumbering{Roman}
	\setcounter{page}{1}

	\setstretch{1.1}
}
% exposé
\newcommand{\beginExpose}{
	\pagenumbering{arabic}
	\setcounter{page}{1}

    \renewcommand*{\thechapter}{}
    \renewcommand*{\chapterformat}{}% No number no space
    \renewcommand*{\chaptermarkformat}{}% No number no space
	\renewcommand{\thesection}{\arabic{section}}
	\renewcommand{\theHsection}{\arabic{section}}
    \counterwithout{section}{chapter}
    % This also results in \renewcommand*{\thesection}{\arabic{section}}
    \counterwithout{figure}{chapter}
    \counterwithout{table}{chapter}
    \counterwithout{equation}{chapter}

	\setstretch{1.25}
}

