% Options for commands and patches that help during writing, but which should be removed in the final version.
\DeclareOptionX{pagebreaks}{
    % Adding a page break before every (sub)section
    \let\oldsection\section
    \renewcommand\section{\clearpage\oldsection}
    \let\oldsubsection\subsection
    \renewcommand\subsection{\clearpage\oldsubsection}
    \let\oldsubsubsection\subsubsection
    \renewcommand\subsubsection{\clearpage\oldsubsubsection}
}

\DeclareOptionX{coloredrefs}{
    \hypersetup{
        colorlinks=true,
        urlcolor=blue,
        linkcolor=blue,
        citecolor=blue,
        linkbordercolor=blue
    }
}

