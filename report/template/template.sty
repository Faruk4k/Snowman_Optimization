\renewcommand*\chapterlinesformat[3]{%
    \fontfamily{ppl}\selectfont\scshape\Large%
    \setbox0=\hbox{#2\unskip}\ifdim\wd0=0pt
        #3%
    \else
        #2\unskip\hspace{1em}#3%
    \fi
    \vspace{1ex}\hrule%
}

\renewcommand*\sectionlinesformat[4]{%
    \fontfamily{ppl}\selectfont\scshape%
    \Ifstr{#1}{section}{\large}{\normalsize}%
    \setbox0=\hbox{#3\unskip}\ifdim\wd0=0pt
        #4%
    \else
        \setbox0=\hbox{\thechapter\unskip}\ifdim\wd0=0pt
            #3\unskip\hspace{1em}#4%
        \else
            #3\unskip\hspace{1em}#4%
        \fi
    \fi
}


